# GitHub API configuration
GITHUB_TOKEN=your_github_token_here

# PostgreSQL + pgvector Database Configuration
DATABASE_URL=postgresql://techradar:techradar@localhost:5433/techradar
POSTGRES_USER=techradar
POSTGRES_PASSWORD=techradar
POSTGRES_DB=techradar
POSTGRES_PORT=5433

# Gemini API Configuration (obtain free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Observability (optional, free tier at https://smith.langchain.com/)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=tech-radar-pipeline
